# ==========================================
# APP / BOOTSTRAP CONFIGURATION
# ==========================================
PORT=3000
NODE_ENV=development

# ==========================================
# DATABASE (MySQL) CONFIGURATION
# ==========================================
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=root
DB_DATABASE=huellas_del_valle
DB_SYNCHRONIZE=false
DB_LOGGING=false
DB_SSL=false
DB_MIGRATIONS_RUN=true

# ==========================================
# AUTH / JWT CONFIGURATION
# ==========================================
JWT_SECRET=your_jwt_secret_key_min_4_chars
JWT_EXPIRES_IN=2h

# ==========================================
# MAIL / SMTP CONFIGURATION
# ==========================================
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Huellas del Valle" <notificaciones@huellasdelvalle.com>
SMTP_SECURE=false
